+    int32_t d0 = d_grp * 8;
+    smem[t_grp][d0 + 0] = s0; smem[t_grp][d0 + 1] = s1;
+    smem[t_grp][d0 + 2] = s2; smem[t_grp][d0 + 3] = s3;
+    smem[t_grp][d0 + 4] = s4; smem[t_grp][d0 + 5] = s5;
+    smem[t_grp][d0 + 6] = s6; smem[t_grp][d0 + 7] = s7;
