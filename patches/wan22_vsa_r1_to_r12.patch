+    __shared__ float smem[16][130];
+    int32_t bh = blockIdx.x;
+    int32_t blk = blockIdx.y;
+    int32_t which = blockIdx.z;
+    int32_t b = bh / H;
+    int32_t h = bh % H;
+    int32_t tid = threadIdx.x;
+    int32_t d_grp = tid & 15;
+    int32_t t_grp = tid >> 4;
