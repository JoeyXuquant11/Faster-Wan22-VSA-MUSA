+        dxv.z = f32x2_to_bf16x2(rstd * (dwx4 - x4 * coeff), rstd * (dwx5 - x5 * coeff));
+        dxv.w = f32x2_to_bf16x2(rstd * (dwx6 - x6 * coeff), rstd * (dwx7 - x7 * coeff));
