+    int64_t p_off = ((int64_t)b * P + p) * D_WAN + c0;
+    *reinterpret_cast<float4*>(p_dgate + p_off)     = make_float4(dg0, dg1, dg2, dg3);
+    *reinterpret_cast<float4*>(p_dgate + p_off + 4) = make_float4(dg4, dg5, dg6, dg7);
