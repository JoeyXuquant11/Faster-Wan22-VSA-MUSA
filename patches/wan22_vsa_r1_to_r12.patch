+        float dwx0 = du0 * w0.x, dwx1 = du1 * w0.y, dwx2 = du2 * w0.z, dwx3 = du3 * w0.w;
+        float dwx4 = du4 * w1.x, dwx5 = du5 * w1.y, dwx6 = du6 * w1.z, dwx7 = du7 * w1.w;
