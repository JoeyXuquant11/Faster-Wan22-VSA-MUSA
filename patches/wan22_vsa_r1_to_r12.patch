+        uint32_t km = __ballot_sync(0xffffffffu, keep); \
+        int32_t pos = out_base + __popc(km & lane_mask); \
+        if (keep) { \
+            outp[pos] = j; \
+            if (pos == i0) qk0 = j; \
+            if (pos == i1) qk1 = j; \
+            if (pos == i2) qk2 = j; \
+            if (pos == i3) qk3 = j; \
+        } \
