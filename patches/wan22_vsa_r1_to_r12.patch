+            dbu2 += bf16_lo_to_f32(duv.y); dbu3 += bf16_hi_to_f32(duv.y);
+            dbu4 += bf16_lo_to_f32(duv.z); dbu5 += bf16_hi_to_f32(duv.z);
+            dbu6 += bf16_lo_to_f32(duv.w); dbu7 += bf16_hi_to_f32(duv.w);
