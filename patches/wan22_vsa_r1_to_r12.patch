+        dg4 += d4 * bf16_lo_to_f32(uv.z); dg5 += d5 * bf16_hi_to_f32(uv.z);
+        dg6 += d6 * bf16_lo_to_f32(uv.w); dg7 += d7 * bf16_hi_to_f32(uv.w);
+    }
